{
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv lock*)",
      "Bash(uv sync*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git branch --show-current)",
      "Bash(gh pr list*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  }
}
